---
source: crates/zendriver-mcp/tests/schema_snapshots.rs
expression: "schema_for! (tools::cloudflare::SolveOutput)"
---
$schema: "https://json-schema.org/draft/2020-12/schema"
title: SolveOutput
description: "Output of `browser_solve_turnstile`."
type: object
properties:
  outcome:
    description: Which terminal state the bypass reached.
    $ref: "#/$defs/Outcome"
  token:
    description: "Turnstile response token. Populated only when `outcome == Solved`;\n`None` for `ChallengeGone` and `Timeout`."
    type:
      - string
      - "null"
required:
  - outcome
$defs:
  Outcome:
    description: "Terminal outcome of a turnstile bypass attempt.\n\n`AlreadyClear`, `Solved` and `ChallengeGone` mirror the lib's\n`ClearanceOutcome` variants. `Timeout` mirrors the lib's `ClearanceOutcome::TimedOut` — a\ndeadline in a turnstile flow is a normal outcome, not an error —\nsurfacing it on the success channel so agents can branch on `outcome`\nwithout try/catch around a timeout."
    oneOf:
      - description: "The page showed no challenge marker when the solver first saw it\nparsed, so there was nothing to solve; the call returns at once.\nDecided on that first look: a widget a script mounts later is not\nwaited for. `token` will be `None`."
        type: string
        const: already_clear
      - description: "Turnstile produced a token — the first non-empty value of an element\nmatching `selectors.token_inputs`, tried in order;\n`cf-turnstile-response` by default.\nThe token is available in [`SolveOutput::token`]."
        type: string
        const: solved
      - description: "Every challenge marker seen earlier is gone without a token, and the\npage has settled: a navigation replaced it with a parsed document\n(how Cloudflare's full-page challenge ends, on the page it guards),\nor it stayed without markers for three seconds. `token` will be\n`None`.\n\nNot proof the gate was passed: a replacement page whose every marker\nis added by script after it is parsed lands here too, so verify the\npage before treating what you read next as post-challenge content."
        type: string
        const: challenge_gone
      - description: "`timeout_ms` elapsed without reaching either success state. `token`\nwill be `None`. Not a hard error — agents can retry or give up."
        type: string
        const: timeout
