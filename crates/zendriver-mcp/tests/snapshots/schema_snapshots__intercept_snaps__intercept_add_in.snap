---
source: crates/zendriver-mcp/tests/schema_snapshots.rs
expression: "schema_for! (tools::intercept::AddRuleInput)"
---
$schema: "https://json-schema.org/draft/2020-12/schema"
title: AddRuleInput
description: "Input for `browser_intercept_add_rule`."
type: object
properties:
  action:
    description: Action to take on matches.
    $ref: "#/$defs/InterceptAction"
  hosts:
    description: "Host names (`ads.example`, without scheme, port, path or wildcard):\nthe rule fits a request whose host is one of these or a subdomain of\none. Give exactly one of `pattern` and `hosts`."
    type:
      - array
      - "null"
    default: ~
    items:
      type: string
  label:
    description: "A name for the rule in `browser_intercept_list_rules` and logs."
    type:
      - string
      - "null"
    default: ~
  pattern:
    description: "URL pattern (CDP wildcard syntax: `*` is any run of characters, `?`\none character or none, `\\` escapes), matched against the full\nrequest URL. Give exactly one of `pattern` and `hosts`."
    type:
      - string
      - "null"
    default: ~
  pause:
    description: "The kind of pause the rule decides. Omit for `response_headers` with\n`modify_response`, `request` with the other actions."
    anyOf:
      - $ref: "#/$defs/PauseName"
      - type: "null"
    default: ~
  position:
    description: "Where the rule goes in the current tab's list: `last` unless this\nrule must take requests from an earlier entry. `first` is ahead of\n`browser.trackers`, so a `first` rule that fits a tracker's request\ndecides it; `continue` or `modify_request` there sends the tracker\nrequest."
    $ref: "#/$defs/PositionInput"
  resource_type:
    description: The resource type the rule fits. Omit for any.
    anyOf:
      - $ref: "#/$defs/ResourceTypeName"
      - type: "null"
additionalProperties: false
required:
  - action
  - position
$defs:
  InterceptAction:
    description: "Wire-level interception action. One variant per supported rule kind.\n\nTagged with `kind` so a JSON payload looks like\n`{ \"kind\": \"block\" }` or `{ \"kind\": \"redirect\", \"to\": \"...\" }`, which\nis easier for an agent to construct than a flat field set with mutually\nexclusive shapes."
    oneOf:
      - description: "Let every matching request go on unchanged: an exception that keeps\nthe matching requests from the entries after this rule."
        type: object
        properties:
          kind:
            type: string
            const: continue
        additionalProperties: false
        required:
          - kind
      - description: "Fail every matching request with `BlockedByClient`."
        type: object
        properties:
          kind:
            type: string
            const: block
        additionalProperties: false
        required:
          - kind
      - description: "Send every matching request to `to` instead, unseen by the page.\n`request` pause only."
        type: object
        properties:
          kind:
            type: string
            const: redirect
          to:
            description: "Target URL, sent as it is: nothing of the matched URL is\nsubstituted into it."
            type: string
        additionalProperties: false
        required:
          - kind
          - to
      - description: Synthesize a response with the given status / body / headers.
        type: object
        properties:
          body:
            description: Response body as UTF-8 text.
            type: string
          content_type:
            description: "Convenience for the most common header: when set, a\n`Content-Type: <content_type>` header is added (and overrides\nany same-named entry in `headers`)."
            type:
              - string
              - "null"
            default: ~
          headers:
            description: "Additional response headers. Lexicographically sorted (`BTreeMap`)\nfor stable wire output."
            type: object
            additionalProperties:
              type: string
            default: {}
          kind:
            type: string
            const: respond
          status:
            description: "HTTP status code (e.g. `200`, `404`)."
            type: integer
            format: uint16
            maximum: 65535
            minimum: 0
        additionalProperties: false
        required:
          - kind
          - status
          - body
      - description: "Continue the request with extra / replaced headers and/or a replaced\nURL / method / body. Any field left `None` keeps Chrome's original.\n`request` pause only."
        type: object
        properties:
          headers:
            description: "Headers to merge over the request's originals. CDP's\n`continueRequest.headers` is a full replacement, so the closure\nrebuilds the header list from the intercepted request and\noverlays these entries (case-insensitive on names)."
            type: object
            additionalProperties:
              type: string
            default: {}
          kind:
            type: string
            const: modify_request
          method:
            description: "Replace the HTTP method (e.g. `\"POST\"`). Omit to keep the\noriginal."
            type:
              - string
              - "null"
            default: ~
          post_data:
            description: "Replace the request body, as UTF-8 text. Omit to keep the\noriginal. The core [`RequestOverrides::post_data`] field is\n`Vec<u8>`; this is encoded via `String::into_bytes`, so it can't\ncarry a non-UTF-8 body."
            type:
              - string
              - "null"
            default: ~
          url:
            description: Replace the request URL. Omit to keep the original.
            type:
              - string
              - "null"
            default: ~
        additionalProperties: false
        required:
          - kind
      - description: "Continue the *response* with an overridden status and/or headers.\nOther fields are left at Chrome's originals. The body is not\nrewritten — use `respond` to synthesize a whole response instead.\n`response_headers` pause only."
        type: object
        properties:
          headers:
            description: "Headers to merge over the response's originals (full-replacement\nsemantics, same as `modify_request`; case-insensitive names)."
            type: object
            additionalProperties:
              type: string
            default: {}
          kind:
            type: string
            const: modify_response
          status:
            description: "Override the HTTP status code. Omit to keep Chrome's original."
            type:
              - integer
              - "null"
            format: uint16
            default: ~
            maximum: 65535
            minimum: 0
        additionalProperties: false
        required:
          - kind
  PauseName:
    description: The kind of pause a rule decides.
    oneOf:
      - description: Before the request is sent.
        type: string
        const: request
      - description: "Once the response's status and headers arrived (4xx and 5xx\nincluded)."
        type: string
        const: response_headers
      - description: "When the request failed before any status (DNS, connection, ...)."
        type: string
        const: response_error
  PositionInput:
    description: "Where in the current tab's list a rule goes, in the list as it is at\nthat moment: `\"first\"`, `\"last\"`, `{ \"before\": \"<rule_id>\" }` or\n`{ \"after\": \"<rule_id>\" }`."
    oneOf:
      - description: "Ahead of every entry, `browser.trackers` included."
        type: string
        const: first
      - description: Behind every entry.
        type: string
        const: last
      - description: "Just ahead of the entry with this `rule_id`."
        type: object
        properties:
          before:
            type: string
        additionalProperties: false
        required:
          - before
      - description: "Just behind the entry with this `rule_id`."
        type: object
        properties:
          after:
            type: string
        additionalProperties: false
        required:
          - after
  ResourceTypeName:
    description: "A Chrome resource type (CDP `Network.ResourceType`), of those Chrome\ncan pause by type. `XHR`, `Fetch` and `EventSource` are one type to\nChrome: each fits all three."
    type: string
    enum:
      - Document
      - Stylesheet
      - Image
      - Media
      - Font
      - Script
      - XHR
      - Fetch
      - EventSource
      - Ping
      - CSPViolationReport
      - Other
